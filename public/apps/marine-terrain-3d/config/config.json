        "style": { "left": "155px", "right": "0px", "bottom": "0px" },
        "template": "<div>Lng: {lng}°</div> <div>Lat: {lat}°</div> <div>Elev: {alt} m</div> <div class='hide700'>Zoom: {level}</div><div>Heading: {heading}°</div> <div>Pitch: {pitch}°</div><div class='hide700'>Cam Alt: {cameraHeight} m</div>"
